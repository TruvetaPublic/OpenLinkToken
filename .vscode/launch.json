{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // First-time setup: run "Setup 1" then "Setup 2" once. The consumer
  // launches below pick up the resulting exchange config and auto-discover
  // the matching private key from ~/.openlinktoken/.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Setup 1: generate-key-pair (recipient)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": ["generate-key-pair", "--name", "local-recipient", "--force"]
    },
    {
      "name": "Setup 2: initiate-exchange",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "initiate-exchange",
        "--public-key",
        "${env:HOME}/.openlinktoken/local-recipient.public.pem",
        "--output",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/local.exchange.json",
        "--force"
      ]
    },
    {
      "name": "Python: tokenize (demo mode)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "tokenize",
        "--demo-mode",
        "-i",
        "resources/sample.${input:inputType}",
        "-t",
        "${input:inputType}",
        "-o",
        "lib/python/openlinktoken-cli/target/output.${input:outputType}",
        "-ot",
        "${input:outputType}"
      ]
    },
    {
      "name": "Python: tokenize (exchange config)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "tokenize",
        "-i",
        "${workspaceFolder}/resources/sample.${input:inputType}",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/output.${input:outputType}",
        "-ot",
        "${input:outputType}",
        "--exchange-config",
        "${input:exchangeConfigPath}",
        "--mode",
        "${input:tokenizeMode}"
      ]
    },
    {
      "name": "Python: package",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "package",
        "-i",
        "${workspaceFolder}/resources/sample.${input:inputType}",
        "-t",
        "${input:inputType}",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/packaged.${input:outputType}",
        "-ot",
        "${input:outputType}",
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: encrypt",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "encrypt",
        "-i",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/output.${input:inputType}",
        "-t",
        "${input:inputType}",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/encrypted.${input:outputType}",
        "-ot",
        "${input:outputType}",
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: decrypt",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "decrypt",
        "-i",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/encrypted.${input:inputType}",
        "-t",
        "${input:inputType}",
        "-o",
        "lib/python/openlinktoken-cli/target/decrypted.${input:outputType}",
        "-ot",
        "${input:outputType}",
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: generate-key-pair",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "generate-key-pair",
        "--name",
        "debug-key",
        "--curve",
        "P-256",
        "--force"
      ]
    },
    {
      "name": "Python: initiate-exchange",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "initiate-exchange",
        "--name",
        "debug-exchange",
        "--public-key",
        "${env:HOME}/.openlinktoken/receiver.public.pem",
        "--output",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/debug-exchange.exchange.json",
        "--rotation-count",
        "30",
        "--rotation-bin-width",
        "0.05",
        "--rotation-embedding-dimension",
        "1024",
        "--force"
      ]
    },
    {
      "name": "Python: update (dry run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": ["update", "--dry-run"]
    },
    {
      "name": "Python: inspect-exchange-config",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/exchange/inspect_exchange_config.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: inspect-exchange-config (JSON)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/exchange/inspect_exchange_config.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "--exchange-config",
        "${input:exchangeConfigPathForInspect}",
        "--json"
      ]
    }
  ],
  "inputs": [
    {
      "id": "inputType",
      "type": "pickString",
      "description": "Select input type",
      "options": ["csv", "parquet"],
      "default": "csv"
    },
    {
      "id": "outputType",
      "type": "pickString",
      "description": "Select output type",
      "options": ["csv", "parquet"],
      "default": "csv"
    },
    {
      "id": "exchangeConfigPath",
      "type": "promptString",
      "description": "Path to the exchange config JSON",
      "default": "./openlinktoken-YYYY-MM-DD.exchange.json"
    },
    {
      "id": "exchangeConfigPathForInspect",
      "type": "promptString",
      "description": "Path to the exchange config JSON for inspection",
      "default": "${workspaceFolder}/lib/python/openlinktoken-cli/target/debug-exchange.exchange.json"
    },
    {
      "id": "tokenizeMode",
      "type": "pickString",
      "description": "Select tokenize mode",
      "options": ["default", "hash-only", "demo"],
      "default": "default"
    }
  ]
}
