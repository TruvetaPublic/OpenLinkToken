{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // First-time setup: run "Setup 1" then "Setup 2" once. The consumer
  // launches below pick up the resulting exchange config and auto-discover
  // the matching private key from ~/.openlinktoken/.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Setup 1: generate-key-pair (recipient)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "generate-key-pair",
        "--crypto-suite",
        "${input:cryptoSuite}",
        "--name",
        "local-recipient",
        "--force"
      ]
    },
    {
      "name": "Setup 2: initiate-exchange",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "initiate-exchange",
        "--crypto-suite",
        "${input:cryptoSuite}",
        "--public-key-base",
        "${env:HOME}/.openlinktoken/local-recipient",
        "--output",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/local.exchange.json",
        "--force"
      ]
    },
    {
      "name": "Python: tokenize",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "tokenize",
        "-i",
        "${workspaceFolder}/resources/sample.csv",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/output.csv",
        "--exchange-config",
        "${input:exchangeConfigPath}",
        "--mode",
        "${input:tokenizeMode}"
      ]
    },
    {
      "name": "Python: package",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "package",
        "-i",
        "${workspaceFolder}/resources/sample.csv",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/packaged.csv",
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: encrypt",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "encrypt",
        "-i",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/output.csv",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/encrypted.csv",
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: decrypt",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "decrypt",
        "-i",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/encrypted.csv",
        "-o",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/decrypted.csv",
        "--exchange-config",
        "${input:exchangeConfigPath}"
      ]
    },
    {
      "name": "Python: generate-key-pair",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "generate-key-pair",
        "--name",
        "debug-key",
        "--curve",
        "P-256",
        "--force"
      ]
    },
    {
      "name": "Python: generate-key-bundle (PQ)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "generate-key-pair",
        "--crypto-suite",
        "${input:cryptoSuite}",
        "--name",
        "debug-pq-key",
        "--force"
      ]
    },
    {
      "name": "Python: initiate-exchange",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "initiate-exchange",
        "--name",
        "debug-exchange",
        "--public-key",
        "${env:HOME}/.openlinktoken/receiver.public.pem",
        "--output",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/debug-exchange.exchange.json",
        "--rotation-count",
        "50",
        "--rotation-bin-width",
        "0.05",
        "--rotation-embedding-dimension",
        "1024",
        "--force"
      ]
    },
    {
      "name": "Python: initiate-exchange (PQ)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "initiate-exchange",
        "--crypto-suite",
        "${input:cryptoSuite}",
        "--name",
        "debug-pq-exchange",
        "--public-key",
        "${input:publicKeyBundlePath}",
        "--output",
        "${workspaceFolder}/lib/python/openlinktoken-cli/target/debug-pq-exchange.exchange.json",
        "--force"
      ]
    },
    {
      "name": "Python: update (dry run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lib/python/openlinktoken-cli/src/main/openlinktoken_cli/main.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": ["update", "--dry-run"]
    },
    {
      "name": "Python: inspect-exchange-config",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/exchange/inspect_exchange_config.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": ["--exchange-config", "${input:exchangeConfigPath}"]
    },
    {
      "name": "Python: inspect-exchange-config (JSON)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/exchange/inspect_exchange_config.py",
      "env": {
        "PYTHONPATH": "lib/python/openlinktoken-cli/src/main:lib/python/openlinktoken/src/main:lib/python/openlinktoken-core-ai/src/main"
      },
      "args": [
        "--exchange-config",
        "${input:exchangeConfigPathForInspect}",
        "--json"
      ]
    }
  ],
  "inputs": [
    {
      "id": "exchangeConfigPath",
      "type": "promptString",
      "description": "Path to the exchange config JSON",
      "default": "${workspaceFolder}/lib/python/openlinktoken-cli/target/local.exchange.json"
    },
    {
      "id": "exchangeConfigPathForInspect",
      "type": "promptString",
      "description": "Path to the exchange config JSON for inspection",
      "default": "${workspaceFolder}/lib/python/openlinktoken-cli/target/local.exchange.json"
    },
    {
      "id": "tokenizeMode",
      "type": "pickString",
      "description": "Select tokenize mode",
      "options": ["default", "hash-only", "demo"],
      "default": "default"
    },
    {
      "id": "cryptoSuite",
      "type": "pickString",
      "description": "Select the crypto suite",
      "options": [
        "suite-pq-v1",
        "suite-pq-shake-v1",
        "suite-pq-hybrid-v1",
        "suite-sha3-v1",
        "suite-sha256-v1"
      ],
      "default": "suite-sha256-v1"
    },
    {
      "id": "publicKeyBundlePath",
      "type": "promptString",
      "description": "Path to the partner public JSON key bundle",
      "default": "${env:HOME}/.openlinktoken/partner.public.bundle.json"
    }
  ]
}
